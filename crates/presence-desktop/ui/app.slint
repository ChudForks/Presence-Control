import { ScrollView, Palette } from "std-widgets.slint";
import { Colors, Typography, Glyph, UiButton, IconButton, Input, Field, SectionTitle, Toggle, Artwork, Note, Divider, Choice, EmptyState, PriorityHandle, ModeOption } from "components.slint";

export struct ProfileRow { id: string, title: string, subtitle: string, theme: string, selected: bool, artwork: image, has-artwork: bool }
export struct RuleRow { id: string, name: string, process: string, profile: string, enabled: bool }
export struct AppRow { id: string, process: string, title: string }
export struct ActivityRow { id: string, kind: string, title: string, subtitle: string, time: string, detail: string, locked: bool, tracked: bool }
export struct ProfileForm {
    id: string, name: string, application-id: string, app-name: string, activity-type: int,
    details: string, state: string, large-image: string, large-text: string, small-image: string, small-text: string,
    elapsed: bool, progress: bool, duration: string, theme: string,
    button1-label: string, button1-url: string, button2-label: string, button2-url: string, button-count: int
}
export struct RuleForm { id: string, name: string, process: string, title-contains: string, profile-id: string, profile-index: int, enabled: bool }

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> enabled: true;
    in property <string> count;
    callback clicked();
    height: 44px;
    border-radius: 8px;
    background: selected ? Colors.raised : nav-touch.has-hover ? Colors.subtle-hover : transparent;
    border-width: selected ? 1px : 0px;
    border-color: Colors.line;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout { cross-axis-alignment: center;
        padding-left: 13px; padding-right: 13px; spacing: 11px;
        Glyph { name: root.icon; colorize: root.selected ? Colors.heading : Colors.muted; }
        if !compact: Text { text: root.text; color: root.selected ? Colors.text : Colors.secondary; font-size: 13px; font-weight: root.selected ? Typography.selected-nav-weight : Typography.label-weight; vertical-alignment: center; horizontal-stretch: 1; }
        if !compact && count != "": Rectangle { width: 20px; height: 20px; border-radius: 4px; border-width: 1px; border-color: Colors.strong-line; background: Colors.badge; Text { text: root.count; color: Colors.label; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
    }
    nav-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
}

component HistorySection inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> empty-text;
    in property <[ActivityRow]> entries;
    in property <bool> archived;
    in property <bool> busy;
    in-out property <bool> expanded: true;
    callback action(string,string);
    min-height: history-layout.preferred-height;
    background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
    history-layout := VerticalLayout {
        spacing: 0px;
        Rectangle {
            min-height: heading.preferred-height;
            heading := HorizontalLayout { cross-axis-alignment: center;
                padding: 23px; spacing: 18px;
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0px;
                    spacing: 9px;
                    Text { text: root.title; color: Colors.heading; font-size: 15px; font-weight: Typography.title-weight; }
                    if root.description != "": Text { text: root.description; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
                }
                Text { text: root.entries.length + " entries"; width: 80px; horizontal-stretch: 0; color: Colors.muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                Glyph { name: root.expanded ? "down" : "arrow"; width: 15px; height: 15px; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; } }
        }
        if expanded: VerticalLayout {
            spacing: 0px;
            if root.entries.length == 0: Rectangle {
                min-height: empty.preferred-height + 56px;
                Divider { y: 0px; width: parent.width; }
                empty := Text { x: 24px; y: 25px; width: parent.width - 48px; height: self.preferred-height; text: root.empty-text; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
            }
            for entry in root.entries: entry-box := Rectangle {
                in-out property <bool> entry-expanded: false;
                height: self.entry-expanded ? 126px : 76px;
                Divider { y: 0px; width: parent.width; background: Colors.subtle-line; }
                HorizontalLayout { cross-axis-alignment: center;
                    y: 0px; height: 76px; padding-left: 24px; padding-right: 20px; spacing: 14px;
                    Rectangle { width: 36px; height: 36px; background: Colors.popup; border-width: 1px; border-color: Colors.line; border-radius: 8px; Glyph { name: entry.kind == "event" ? "activity" : "clock"; x: 9px; y: 9px; } }
                    VerticalLayout {
                        horizontal-stretch: 1; min-width: 0px;
                        spacing: 5px; alignment: center;
                        Text { text: entry.title; color: Colors.label; font-size: 12px; font-weight: Typography.title-weight; overflow: elide; }
                        if entry.subtitle != "": Text { text: entry.subtitle; color: Colors.muted; font-size: 11px; overflow: elide; }
                    }
                    Text { text: entry.time; width: 112px; horizontal-stretch: 0; color: Colors.secondary; font-family: "Consolas"; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    HorizontalLayout {
                        width: 124px; horizontal-stretch: 0; spacing: 14px; alignment: end;
                        if !root.archived: IconButton { icon: "archive"; label: entry.tracked ? "Application time is in Archive" : "Archive entry"; enabled: !root.busy && !entry.tracked && (!entry.locked || entry.kind == "application"); clicked => { root.action("archive-activity", entry.kind + ":" + entry.id); } }
                        IconButton { icon: "trash"; label: "Delete entry"; enabled: !root.busy && !entry.locked; clicked => { root.action(root.archived ? "delete-archived" : "delete-activity", entry.kind + ":" + entry.id); } }
                        IconButton { icon: "down"; label: "Expand entry"; clicked => { entry-box.entry-expanded = !entry-box.entry-expanded; } }
                    }
                }
                if self.entry-expanded: Text { x: 74px; y: 77px; width: parent.width - 98px; height: self.preferred-height; text: entry.detail; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
    }
}

component Preview inherits VerticalLayout {
    in property <bool> enabled: true;
    in property <ProfileForm> form;
    in property <string> preview-name;
    in property <string> preview-details;
    in property <string> preview-state;
    in property <string> preview-large-text;
    in property <string> preview-kind;
    in property <string> preview-time;
    in property <string> preview-duration;
    in property <float> preview-fraction;
    in property <bool> has-playback;
    in property <string> status;
    in property <string> connection;
    in property <image> large-image;
    in property <image> small-image;
    in property <bool> has-large-image;
    in property <bool> has-small-image;
    callback setup();
    spacing: 14px;
    alignment: start;
    HorizontalLayout { cross-axis-alignment: center;
        Text { text: "LIVE PREVIEW"; color: Colors.secondary; font-size: 10px; font-weight: Typography.caption-weight; letter-spacing: 1px; }
        Text { text: "•  Updates as you type"; color: Colors.muted; font-size: 10px; horizontal-alignment: right; }
    }
    Rectangle {
        height: profile-content.preferred-height + 188px; vertical-stretch: 0;
        background: Colors.raised; border-width: 1px; border-color: Colors.strong-line; border-radius: 13px;
        Image {
            x: 1px; y: 1px; width: parent.width - 2px; height: 100px; image-fit: fill;
            // Rounded gradients and clips are baked into the SVG because the
            // native software renderer paints gradient Rectangle corners square.
            source: root.form.theme == "mint" ? @image-url("artwork/mint-banner.svg") : root.form.theme == "peach" ? @image-url("artwork/peach-banner.svg") : root.form.theme == "blue" ? @image-url("artwork/blue-banner.svg") : @image-url("artwork/violet-banner.svg");
        }
        Rectangle {
            x: 19px; y: 65px; width: 70px; height: 70px; border-radius: 35px; background: #c8c8c8; border-width: 6px; border-color: Colors.raised;
            Glyph { name: "audio"; x: 19px; y: 19px; width: 32px; height: 32px; colorize: #292929; }
            Rectangle { x: 51px; y: 50px; width: 17px; height: 17px; border-radius: 9px; border-width: 4px; border-color: Colors.raised; background: Colors.positive; }
        }
        profile-content := VerticalLayout {
            x: 19px; y: 154px; width: parent.width - 38px; height: self.preferred-height;
            spacing: 18px;
            HorizontalLayout { cross-axis-alignment: center;
                spacing: 8px;
                Text { text: "Your profile"; color: Colors.heading; font-size: 20px; font-weight: Typography.title-weight; horizontal-stretch: 0; }
                Rectangle { width: 26px; height: 18px; background: Colors.badge; border-width: 1px; border-color: Colors.strong-line; border-radius: 4px; Text { text: "you"; color: Colors.secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
            Divider { }
            VerticalLayout {
                spacing: 12px;
                Text { text: root.preview-kind; color: Colors.muted; font-size: 10px; font-weight: Typography.caption-weight; letter-spacing: 0.5px; overflow: elide; }
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: 12px;
                    Rectangle {
                        width: 62px; height: 62px; background: transparent;
                        Artwork { width: 62px; height: 62px; theme: root.form.theme; artwork: root.large-image; has-artwork: root.has-large-image; }
                        if root.form.small-image != "": Rectangle {
                            x: 45px; y: 45px; width: 25px; height: 25px; border-width: 3px; border-color: Colors.raised; border-radius: 13px; background: #425e53;
                            Artwork { x: 3px; y: 3px; width: 19px; height: 19px; theme: "mint"; artwork: root.small-image; has-artwork: root.has-small-image; }
                        }
                    }
                    VerticalLayout {
                        spacing: 5px; alignment: start;
                        Text { text: root.form.activity-type == 2 ? root.preview-details : root.preview-name; color: Colors.heading; font-size: 13px; font-weight: Typography.title-weight; wrap: word-wrap; }
                        if root.form.activity-type != 2 && root.preview-details != "": Text { text: root.preview-details; color: Colors.secondary; font-size: 11px; wrap: word-wrap; }
                        if root.preview-state != "": Text { text: root.preview-state; color: Colors.secondary; font-size: 11px; wrap: word-wrap; }
                        if root.form.activity-type == 2 && root.preview-large-text != "": Text { text: root.preview-large-text; color: Colors.secondary; font-size: 11px; wrap: word-wrap; }
                        if root.form.elapsed && !root.has-playback: Text { text: root.preview-time; color: Colors.muted; font-size: 10px; }
                    }
                }
                if root.has-playback: VerticalLayout {
                    spacing: 5px;
                    Rectangle { height: 4px; border-radius: 2px; background: Colors.strong-line; Rectangle { width: max(2px, min(1, max(0, root.preview-fraction)) * parent.width); height: 4px; background: Colors.label; } }
                    HorizontalLayout { cross-axis-alignment: center; Text { text: root.preview-time; color: Colors.secondary; font-size: 10px; } Text { text: root.preview-duration; color: Colors.secondary; font-size: 10px; horizontal-alignment: right; } }
                }
                for i in root.form.button-count: Rectangle {
                    min-height: 34px; border-radius: 6px; background: Colors.badge; border-width: 1px; border-color: Colors.strong-line;
                    HorizontalLayout { cross-axis-alignment: center; alignment: center; spacing: 6px; Text { text: i == 0 ? (root.form.button1-label == "" ? "Button 1" : root.form.button1-label) : (root.form.button2-label == "" ? "Button 2" : root.form.button2-label); color: Colors.label; font-size: 11px; font-weight: Typography.title-weight; } Glyph { name: "external"; width: 11px; height: 11px; } }
                }
            }
            Rectangle { height: 38px; border-width: 1px; border-color: Colors.line; border-radius: 7px; HorizontalLayout { cross-axis-alignment: center; padding-left: 11px; padding-right: 11px; Text { text: "Your presence, at a glance."; color: Colors.muted; font-size: 10px; vertical-alignment: center; } Glyph { name: "wand"; width: 13px; height: 13px; } } }
        }
    }
    HorizontalLayout { cross-axis-alignment: center; alignment: center; spacing: 6px; Glyph { name: "monitor"; width: 13px; height: 13px; } Text { text: "An approximation of your Discord profile"; color: Colors.muted; font-size: 10px; } }
    Rectangle {
        min-height: 88px; border-radius: 11px; border-width: 1px; border-color: Colors.line; background: Colors.surface;
        VerticalLayout {
            padding: 17px; spacing: 16px;
            HorizontalLayout { cross-axis-alignment: center; Text { text: root.connection == "connected" ? "YOUR PRESENCE IS LIVE" : "READY WHEN YOU ARE"; color: Colors.secondary; font-size: 9px; font-weight: Typography.caption-weight; letter-spacing: 1px; } Glyph { name: "radio"; width: 13px; height: 13px; colorize: Colors.positive; } }
            HorizontalLayout { cross-axis-alignment: center; spacing: 8px; Text { width: 5px; text: "•"; color: Colors.warning; } Text { horizontal-stretch: 1; text: root.status; color: Colors.secondary; font-size: 11px; overflow: elide; } UiButton { text: "Set up  →"; compact: true; enabled: root.enabled; clicked => { root.setup(); } } }
        }
    }
}

export component MainWindow inherits Window {
    title: "Presence Control — Rust";
    icon: @image-url("../../../assets/icon.png");
    preferred-width: 1470px;
    preferred-height: 1000px;
    min-width: 800px;
    min-height: 620px;
    background: Colors.background;
    // Match the text face used by the pre-native studio, including its medium weights.
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;
    default-font-weight: Typography.body-weight;
    in-out property <int> page: 0;
    in property <string> app-version;
    in property <string> appearance: "dark";
    out property <bool> dark-appearance: Colors.dark;
    in-out property <int> editor-tab: 0;
    in-out property <ProfileForm> form;
    in-out property <RuleForm> rule-form;
    in property <string> global-id;
    in-out property <string> global-id-draft;
    out property <bool> global-id-dirty: root.global-id-draft != root.global-id;
    in-out property <string> search;
    in-out property <bool> automatic;
    in-out property <bool> record-time;
    in-out property <bool> dirty;
    in-out property <bool> busy;
    in property <bool> selected-live;
    in-out property <bool> scanning;
    in-out property <string> modal;
    in property <[ProfileRow]> profiles;
    in property <[RuleRow]> rules;
    in property <[AppRow]> apps;
    in property <[ActivityRow]> events;
    in property <[ActivityRow]> totals;
    in property <[ActivityRow]> sessions;
    in property <[ActivityRow]> archived;
    in property <[string]> profile-names;
    in property <string> preview-name;
    in property <string> preview-details;
    in property <string> preview-state;
    in property <string> preview-large-text;
    in property <string> preview-kind;
    in property <string> preview-time;
    in property <string> preview-duration;
    in property <float> preview-fraction;
    in property <bool> has-playback;
    in property <string> connection;
    in property <string> status;
    in property <string> message;
    in property <string> data-path;
    in property <image> preview-large;
    in property <image> editor-artwork;
    in property <image> preview-small;
    in property <bool> has-preview-large;
    in property <bool> has-preview-small;
    callback action(string,string);
    callback field-edited(string,string);
    callback rule-edited(string,string);
    pure callback rule-drag-data(string) -> data-transfer;
    pure callback rule-drag-id(data-transfer) -> string;
    callback rule-reordered(string,string,bool);
    private property <bool> compact-nav: root.width < 1040px;
    private property <length> sidebar-width: compact-nav ? 72px : 224px;
    private property <string> page-title: page == 0 ? "Presence studio" : page == 1 ? "App integrations" : page == 2 ? "Activity log" : page == 3 ? "Archive" : "Settings";
    init => { root.apply-appearance(); }
    changed appearance => { root.apply-appearance(); }
    function apply-appearance() {
        Palette.color-scheme = root.appearance == "light" ? ColorScheme.light : root.appearance == "system" ? ColorScheme.unknown : ColorScheme.dark;
    }
    changed modal => { if root.modal != "" { dialog-focus.focus(); } }

    Rectangle {
        x: 0px; y: 0px; width: root.sidebar-width; height: parent.height;
        background: Colors.background;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Colors.subtle-line; }
        HorizontalLayout { cross-axis-alignment: center;
            x: root.compact-nav ? 18px : 23px; y: 32px; width: parent.width - 40px; height: 38px; spacing: 11px; alignment: start;
            Image { source: @image-url("../../../assets/icon.svg"); width: 36px; height: 36px; image-fit: contain; }
            if !root.compact-nav: Text { text: "presence."; color: Colors.heading; font-size: 26px; font-weight: Typography.brand-weight; letter-spacing: -1.2px; vertical-alignment: center; }
        }
        if !root.compact-nav: Text { x: 25px; y: 117px; text: "YOUR WORKSPACE"; color: Colors.muted; font-size: 10px; letter-spacing: 1.6px; font-weight: Typography.caption-weight; }
        VerticalLayout {
            x: 12px; y: 143px; width: parent.width - 24px; spacing: 5px;
            NavItem { enabled: root.modal == ""; text: "Presence studio"; icon: "layers"; selected: root.page == 0; compact: root.compact-nav; count: root.profile-names.length; clicked => { root.page = 0; } }
            NavItem { enabled: root.modal == ""; text: "App integrations"; icon: "wand"; selected: root.page == 1; compact: root.compact-nav; clicked => { root.page = 1; } }
            NavItem { enabled: root.modal == ""; text: "Activity log"; icon: "activity"; selected: root.page == 2; compact: root.compact-nav; clicked => { root.page = 2; } }
        }
        NavItem { enabled: root.modal == ""; x: 12px; y: parent.height - 67px; width: parent.width - 24px; text: "Settings"; icon: "settings"; selected: root.page == 4; compact: root.compact-nav; clicked => { root.page = 4; } }
    }
    Rectangle {
        x: root.sidebar-width; y: 0px; width: parent.width - root.sidebar-width; height: 68px; background: Colors.background;
        Divider { y: parent.height - 1px; width: parent.width; background: Colors.subtle-line; }
        HorizontalLayout { cross-axis-alignment: center;
            padding-left: 36px; padding-right: 28px; spacing: 16px;
            Text { text: "Workspace"; color: Colors.muted; font-size: 12px; vertical-alignment: center; }
            Text { text: "›"; color: Colors.focus; font-size: 18px; vertical-alignment: center; }
            Text { text: root.page-title; color: Colors.label; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
            Rectangle {
                width: status-text.preferred-width + 24px; height: 31px; border-width: 1px; border-color: root.connection == "connected" ? Colors.positive-line : Colors.line; border-radius: 16px; background: root.connection == "connected" ? Colors.positive-surface : Colors.surface;
                status-text := Text { x: 12px; height: parent.height; text: root.connection == "connected" ? "•  Connected to Discord" : root.connection == "connecting" ? "•  Connecting…" : "•  Discord disconnected"; color: root.connection == "connected" ? Colors.positive : Colors.secondary; font-size: 11px; vertical-alignment: center; }
            }
            Rectangle { width: 1px; height: 18px; background: Colors.line; }
            IconButton { enabled: root.modal == ""; icon: "help"; label: "Setup help"; clicked => { root.page = 0; root.editor-tab = 3; } }
        }
    }

    scroll := ScrollView { enabled: root.modal == "";
        x: root.sidebar-width; y: 68px; width: parent.width - root.sidebar-width; height: parent.height - 68px;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        VerticalLayout {
            width: scroll.visible-width;
            padding-top: 42px; padding-left: root.compact-nav ? 24px : 36px; padding-right: root.compact-nav ? 24px : 26px; padding-bottom: 25px;
            spacing: root.page == 0 ? 38px : 26px;
            HorizontalLayout { cross-axis-alignment: center;
                min-height: 45px;
                Text { text: root.page-title; color: Colors.heading; font-size: 36px; font-weight: Typography.heading-weight; letter-spacing: -1.35px; vertical-alignment: center; horizontal-stretch: 1; }
                if root.page == 0: UiButton { text: "New presence"; icon: "plus"; primary: true; enabled: root.modal == "" && !root.busy; clicked => { root.action("new-profile", ""); } }
                if root.page == 1: UiButton { text: "Add application"; icon: "plus"; primary: true; enabled: root.modal == "" && !root.busy; clicked => { root.action("new-rule", ""); } }
                if root.page == 2: UiButton { enabled: root.modal == ""; text: "Archive"; icon: "archive"; clicked => { root.page = 3; } }
                if root.page == 3: UiButton { enabled: root.modal == ""; text: "Activity log"; icon: "activity"; clicked => { root.page = 2; } }
            }

            if root.page == 0: VerticalLayout {
                spacing: 24px;
                VerticalLayout {
                    spacing: 14px;
                    HorizontalLayout { cross-axis-alignment: center;
                        spacing: 10px;
                        Text { text: "Your presences"; color: Colors.label; font-size: 12px; font-weight: Typography.title-weight; vertical-alignment: center; }
                        Text { text: root.profile-names.length; color: Colors.muted; font-size: 10px; vertical-alignment: center; }
                        Rectangle { background: transparent; horizontal-stretch: 1; }
                        Input { enabled: root.modal == ""; width: 190px; height: 34px; text <=> root.search; placeholder: "Find a presence…"; edited(value) => { root.action("search", value); } }
                    }
                    ScrollView {
                        height: 88px; horizontal-scrollbar-policy: as-needed; vertical-scrollbar-policy: always-off;
                        content-height: 80px;
                        content-width: max(self.visible-width, root.profiles.length * 230px);
                        HorizontalLayout { cross-axis-alignment: center;
                            spacing: 12px;
                            for profile in root.profiles: Rectangle {
                                min-width: 218px; height: 80px; background: profile.selected ? Colors.selected : Colors.surface;
                                border-width: 1px; border-color: profile.selected ? Colors.muted : Colors.line; border-radius: 11px;
                                accessible-role: button; accessible-label: profile.title; accessible-enabled: root.modal == "";
                                accessible-action-default => { if root.modal == "" { root.action("select-profile", profile.id); } }
                                HorizontalLayout { cross-axis-alignment: center;
                                    padding-left: 16px; padding-right: 16px; spacing: 14px;
                                    Artwork { width: 42px; height: 42px; theme: profile.theme; artwork: profile.artwork; has-artwork: profile.has-artwork; }
                                    VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 7px; alignment: center; Text { text: profile.title; color: Colors.heading; font-size: 13px; font-weight: Typography.title-weight; overflow: elide; } Text { text: profile.subtitle; color: Colors.muted; font-size: 11px; overflow: elide; } }
                                    Text { width: 16px; text: profile.selected ? "✓" : "›"; color: profile.selected ? Colors.label : Colors.placeholder; font-size: 17px; vertical-alignment: center; }
                                }
                                TouchArea { enabled: root.modal == ""; mouse-cursor: pointer; clicked => { card-focus.focus(); root.action("select-profile", profile.id); } }
                                card-focus := FocusScope { enabled: root.modal == ""; focus-on-click: false; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.action("select-profile", profile.id); return accept; } return reject; } }
                                forward-focus: card-focus;
                            }
                            if root.profiles.length == 0: Text { text: "No presences match your search."; color: Colors.muted; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
                HorizontalLayout { cross-axis-alignment: start;
                    spacing: 26px;
                    Rectangle {
                        min-width: 430px; height: max(340px, root.height - 385px); horizontal-stretch: 1; vertical-stretch: 0;
                        background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 13px;
                        editor-layout := VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 82px;
                                HorizontalLayout { cross-axis-alignment: center;
                                    padding-left: 24px; padding-right: 24px; spacing: 12px;
                                    Rectangle { width: 36px; height: 36px; border-radius: 10px; border-width: 1px; border-color: Colors.strong-line; background: Colors.raised; Glyph { name: "settings"; x: 10px; y: 10px; width: 16px; height: 16px; } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 7px; Text { text: root.form.name; color: Colors.heading; font-size: 15px; font-weight: Typography.title-weight; overflow: elide; } Text { text: root.dirty ? "•  Unsaved changes" : "✓  All changes saved"; color: root.dirty ? Colors.warning : Colors.muted; font-size: 11px; } }
                                    IconButton { icon: "copy"; label: "Duplicate presence"; enabled: root.modal == "" && !root.busy; clicked => { root.action("duplicate-profile", ""); } }
                                    IconButton { icon: "trash"; label: "Delete presence"; enabled: root.modal == "" && !root.busy && root.profile-names.length > 1; clicked => { root.action("delete-profile", ""); } }
                                    Rectangle { width: 1px; height: 18px; background: Colors.line; }
                                    UiButton { text: "Save"; icon: "check"; compact: true; enabled: root.modal == "" && root.dirty && !root.busy; clicked => { root.action("save-profile", ""); } }
                                }
                            }
                            Divider { background: Colors.subtle-line; }
                            Rectangle {
                                height: 49px;
                                HorizontalLayout { cross-axis-alignment: center;
                                    padding-left: 24px; spacing: 24px; alignment: start;
                                    for tab[index] in ["General", "Artwork", "Buttons", "Connection"]: Rectangle {
                                        width: tab-text.preferred-width + 23px; height: 49px;
                                        accessible-role: button; accessible-label: tab + " editor tab"; accessible-enabled: root.modal == "";
                                        accessible-action-default => { if root.modal == "" { root.editor-tab = index; } }
                                        HorizontalLayout { cross-axis-alignment: center; spacing: 7px; Glyph { name: index == 0 ? "code" : index == 1 ? "image" : index == 2 ? "link" : "plug"; width: 14px; height: 14px; colorize: root.editor-tab == index ? Colors.heading : Colors.muted; } tab-text := Text { text: tab; color: root.editor-tab == index ? Colors.heading : Colors.muted; font-size: 11px; vertical-alignment: center; } }
                                        if root.editor-tab == index: Rectangle { y: parent.height - 2px; height: 2px; width: parent.width; background: Colors.heading; }
                                        TouchArea { enabled: root.modal == ""; mouse-cursor: pointer; clicked => { tab-focus.focus(); root.editor-tab = index; } }
                                        tab-focus := FocusScope { enabled: root.modal == ""; focus-on-click: false; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.editor-tab = index; return accept; } if event.text == Key.RightArrow { root.editor-tab = min(3, index + 1); return accept; } if event.text == Key.LeftArrow { root.editor-tab = max(0, index - 1); return accept; } return reject; } }
                                        forward-focus: tab-focus;
                                    }
                                }
                            }
                            Divider { }
                            editor-scroll := ScrollView {
                                enabled: root.modal == "";
                                horizontal-scrollbar-policy: always-off;
                                content-width: self.visible-width;
                                vertical-stretch: 1;
                            VerticalLayout {
                                width: editor-scroll.visible-width;
                                padding: 26px; spacing: 23px;
                                if root.editor-tab == 0: VerticalLayout {
                                    spacing: 23px;
                                    SectionTitle { title: "The basics"; description: "Set the scene. Tell your story."; }
                                    Field { enabled: root.modal == ""; label: "Presence name"; hint: "Just for you. A name to find this presence later."; value <=> root.form.name; placeholder: "e.g. Creative flow"; edited(value) => { root.field-edited("name", value); } }
                                    HorizontalLayout { cross-axis-alignment: center;
                                        spacing: 18px;
                                        Field { enabled: root.modal == ""; label: "Display name"; value <=> root.form.app-name; placeholder: "Discord application name"; edited(value) => { root.field-edited("appName", value); } }
                                        VerticalLayout { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; spacing: 9px; Text { text: "Activity type"; color: Colors.label; font-size: 12px; } Choice { enabled: root.modal == ""; label: "Activity type"; options: ["Playing", "Listening to", "Watching", "Competing in"]; current-index: root.form.activity-type == 2 ? 1 : root.form.activity-type == 3 ? 2 : root.form.activity-type == 5 ? 3 : 0; selected(index) => { root.field-edited("type", index == 1 ? "2" : index == 2 ? "3" : index == 3 ? "5" : "0"); } } }
                                    }
                                    Divider { }
                                    SectionTitle { title: "A little more context"; description: "The details that make it yours."; }
                                    HorizontalLayout { cross-axis-alignment: center;
                                        spacing: 18px;
                                        Field { enabled: root.modal == ""; label: "Details"; value <=> root.form.details; placeholder: "What are you up to?"; edited(value) => { root.field-edited("details", value); } }
                                        Field { enabled: root.modal == ""; label: "State"; value <=> root.form.state; placeholder: "Add a little context"; edited(value) => { root.field-edited("state", value); } }
                                    }
                                    if root.form.activity-type == 2: Field { enabled: root.modal == ""; label: "Third line (album or extra text)"; hint: "Also used as the large image's hover text in Artwork."; value <=> root.form.large-text; placeholder: "Album name or another line of context"; edited(value) => { root.field-edited("largeText", value); } }
                                    Note { text: "Make it dynamic. Use {{app}}, {{title}}, or {{process}} in your text to show the matching application's name, window title, or process."; icon: "code"; }
                                    Divider { }
                                    HorizontalLayout { cross-axis-alignment: center;
                                        SectionTitle { title: "Show elapsed time"; description: "A little timer for your current moment."; }
                                        Toggle { enabled: root.modal == ""; checked: root.form.elapsed; label: "Show elapsed time"; toggled => { root.field-edited("elapsed", root.form.elapsed ? "false" : "true"); } }
                                    }
                                    if root.form.activity-type == 2 || root.form.activity-type == 3: VerticalLayout {
                                        spacing: 18px;
                                        HorizontalLayout { cross-axis-alignment: center; SectionTitle { title: "Playback progress"; description: "Show progress using a duration you enter."; } Toggle { enabled: root.modal == ""; checked: root.form.progress; label: "Playback progress"; toggled => { root.field-edited("progress", root.form.progress ? "false" : "true"); } } }
                                        if root.form.progress: Field { enabled: root.modal == ""; label: "Playback duration"; hint: "Use m:ss or h:mm:ss. Media playback is not read or controlled."; value <=> root.form.duration; placeholder: "3:00"; edited(value) => { root.field-edited("duration", value); } }
                                    }
                                }
                                if root.editor-tab == 1: VerticalLayout {
                                    spacing: 23px;
                                    SectionTitle { title: "Make an impression"; description: "Give your presence a little personality."; }
                                    HorizontalLayout { cross-axis-alignment: center;
                                        spacing: 20px;
                                        Artwork { width: 88px; height: 88px; theme: root.form.theme; artwork: root.editor-artwork; has-artwork: root.has-preview-large; }
                                        VerticalLayout {
                                            spacing: 12px;
                                            Text { text: "Preview theme"; color: Colors.label; font-size: 13px; font-weight: Typography.label-weight; }
                                            Text { text: "A look for your studio preview."; color: Colors.muted; font-size: 11px; }
                                            HorizontalLayout { cross-axis-alignment: center; spacing: 10px; alignment: start; for theme in ["violet", "mint", "peach", "blue"]: Rectangle { width: 28px; height: 28px; border-radius: 14px; border-width: root.form.theme == theme ? 2px : 0px; border-color: Colors.heading; background: theme == "violet" ? #8a7aaf : theme == "mint" ? #577e71 : theme == "peach" ? #a78b79 : #667f9c; TouchArea { mouse-cursor: pointer; clicked => { root.field-edited("theme", theme); } } } }
                                        }
                                    }
                                    Divider { }
                                    Field { enabled: root.modal == ""; label: "Large image"; hint: "An uploaded application asset key or an HTTPS image URL."; value <=> root.form.large-image; placeholder: "e.g. workspace or https://…"; edited(value) => { root.field-edited("largeImage", value); } }
                                    Field { enabled: root.modal == ""; label: "Large image hover text"; value <=> root.form.large-text; placeholder: "A little extra context"; edited(value) => { root.field-edited("largeText", value); } }
                                    HorizontalLayout { cross-axis-alignment: center;
                                        spacing: 18px;
                                        Field { enabled: root.modal == ""; label: "Small image"; value <=> root.form.small-image; placeholder: "Asset key or HTTPS URL"; edited(value) => { root.field-edited("smallImage", value); } }
                                        Field { enabled: root.modal == ""; label: "Small image hover text"; value <=> root.form.small-text; placeholder: "Hover text"; edited(value) => { root.field-edited("smallText", value); } }
                                    }
                                    Note { text: "Uploaded asset names belong to the Discord application you connect with. Preview themes stay in this studio; uploaded artwork and HTTPS images are sent to Discord."; icon: "image"; }
                                }
                                if root.editor-tab == 2: VerticalLayout {
                                    spacing: 23px;
                                    SectionTitle { title: "Keep the conversation going"; description: "Add up to two links to your presence."; }
                                    for i in root.form.button-count: Rectangle {
                                        min-height: button-fields.preferred-height; border-width: 1px; border-color: Colors.line; border-radius: 10px; background: Colors.subtle-hover;
                                        button-fields := VerticalLayout {
                                            padding: 18px; spacing: 19px;
                                            HorizontalLayout { cross-axis-alignment: center; Text { text: "Button " + (i + 1); color: Colors.label; font-size: 12px; font-weight: Typography.title-weight; vertical-alignment: center; } IconButton { enabled: root.modal == ""; icon: "trash"; label: "Remove button"; clicked => { root.action("remove-button", i); } } }
                                            Field { enabled: root.modal == ""; label: "Label"; value: i == 0 ? root.form.button1-label : root.form.button2-label; placeholder: "e.g. My portfolio"; edited(value) => { root.field-edited(i == 0 ? "button1Label" : "button2Label", value); } }
                                            Field { enabled: root.modal == ""; label: "Link"; value: i == 0 ? root.form.button1-url : root.form.button2-url; placeholder: "https://your-site.com"; edited(value) => { root.field-edited(i == 0 ? "button1Url" : "button2Url", value); } }
                                        }
                                    }
                                    if root.form.button-count < 2: UiButton { enabled: root.modal == ""; text: "Add a button    " + root.form.button-count + "/2"; icon: "plus"; clicked => { root.action("add-button", ""); } }
                                    Note { text: "Buttons appear on your Discord profile for other people. Your own Discord client may hide them."; icon: "link"; }
                                }
                                if root.editor-tab == 3: VerticalLayout {
                                    spacing: 23px;
                                    SectionTitle { title: "Your connection to Discord"; description: "Use your global application ID, or choose another for this presence."; }
                                    Note { text: root.global-id == "" ? "Set a global application ID to use across your presences in Settings." : "Global application ID: " + root.global-id; icon: "plug"; }
                                    if root.global-id-dirty: Note { text: "The global application ID has unsaved changes in Settings. Go live saves them when this presence uses the global ID."; }
                                    UiButton { enabled: root.modal == ""; text: "Open Settings  →"; clicked => { root.page = 4; } }
                                    Field { enabled: root.modal == ""; label: "Discord application ID override (optional)"; hint: "Leave blank to use the global ID. Override for a different Discord application or its uploaded artwork."; value <=> root.form.application-id; placeholder: "Use global application ID"; edited(value) => { root.field-edited("applicationId", value); } }
                                    Text { text: "1    Create an application in the Discord Developer Portal.\n\n2    Copy its Application ID from General Information and save it in Settings.\n\n3    Open Discord desktop, save this presence, and go live. Enable activity sharing in Discord's settings."; color: Colors.secondary; font-size: 12px; wrap: word-wrap; }
                                    UiButton { enabled: root.modal == ""; text: "Open Developer Portal"; icon: "external"; clicked => { root.action("developer-portal", ""); } }
                                    Note { text: "Presence Control connects directly to Discord on your computer. Your configuration stays on this device."; icon: "help"; }
                                }
                            }
                            }
                            Divider { background: Colors.subtle-line; }
                            Rectangle {
                                height: 80px;
                                HorizontalLayout { cross-axis-alignment: center; padding-left: 24px; padding-right: 24px; alignment: end; if root.selected-live: UiButton { text: "Stop presence"; icon: "stop"; enabled: root.modal == "" && !root.busy; clicked => { root.action("stop", ""); } } if !root.selected-live: UiButton { text: "Go live   →"; icon: "radio"; primary: true; enabled: root.modal == "" && !root.busy; clicked => { root.action("activate", ""); } } }
                            }
                        }
                    }
                    if root.width > 1120px: Preview {
                        width: 316px; horizontal-stretch: 0; enabled: root.modal == "";
                        form: root.form; preview-name: root.preview-name; preview-details: root.preview-details; preview-state: root.preview-state; preview-large-text: root.preview-large-text; preview-kind: root.preview-kind; preview-time: root.preview-time; preview-duration: root.preview-duration; preview-fraction: root.preview-fraction; has-playback: root.has-playback; status: root.status; connection: root.connection;
                        large-image: root.preview-large; small-image: root.preview-small; has-large-image: root.has-preview-large; has-small-image: root.has-preview-small;
                        setup => { root.editor-tab = 3; }
                    }
                }
                if root.width <= 1120px: Preview {
                    max-width: 400px; horizontal-stretch: 0; enabled: root.modal == "";
                    form: root.form; preview-name: root.preview-name; preview-details: root.preview-details; preview-state: root.preview-state; preview-large-text: root.preview-large-text; preview-kind: root.preview-kind; preview-time: root.preview-time; preview-duration: root.preview-duration; preview-fraction: root.preview-fraction; has-playback: root.has-playback; status: root.status; connection: root.connection;
                    large-image: root.preview-large; small-image: root.preview-small; has-large-image: root.has-preview-large; has-small-image: root.has-preview-small;
                    setup => { root.editor-tab = 3; }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: 26px;
                Rectangle {
                    min-height: 96px; background: @linear-gradient(115deg, Colors.raised, Colors.surface); border-width: 1px; border-color: Colors.strong-line; border-radius: 12px;
                    HorizontalLayout { cross-axis-alignment: center; padding: 24px; spacing: 18px; Rectangle { width: 46px; height: 46px; border-width: 1px; border-color: Colors.strong-line; border-radius: 12px; background: Colors.subtle-line; Glyph { name: "wand"; x: 11px; y: 11px; width: 24px; height: 24px; } } SectionTitle { title: "Automatic presence"; description: root.automatic ? "Checks open applications every 15 seconds. The first matching application is used." : "Switch to the right presence when a matching application is open."; } Text { text: root.automatic ? "Enabled" : "Off"; color: Colors.muted; font-size: 12px; vertical-alignment: center; } Toggle { checked: root.automatic; enabled: root.modal == "" && !root.busy; label: "Automatic presence"; toggled => { root.action("toggle-automatic", ""); } } }
                }
                Rectangle {
                    min-height: rules-layout.preferred-height; background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
                    rules-layout := VerticalLayout {
                        spacing: 0px;
                        VerticalLayout { padding: 24px; spacing: 10px; Text { text: "Applications    " + root.rules.length; color: Colors.heading; font-size: 15px; font-weight: Typography.title-weight; } Text { text: "Drag the handles to set priority. The first enabled matching application wins."; color: Colors.muted; font-size: 12px; wrap: word-wrap; } }
                        if root.rules.length == 0: EmptyState { title: "No applications yet"; description: "Add an application or scan your open windows to get started."; }
                        for rule[index] in root.rules: rule-row := Rectangle {
                            private property <bool> drop-after: false;
                            height: 82px;
                            opacity: handle.dragging ? 0.45 : 1;
                            background: drop.has-drag ? Colors.raised : transparent;
                            Divider { y: 0px; width: parent.width; background: Colors.subtle-line; }
                            HorizontalLayout { cross-axis-alignment: center;
                                padding-left: 20px; padding-right: 20px; spacing: 12px;
                                handle := PriorityHandle { data: root.rule-drag-data(rule.id); label: "Change priority for " + rule.name; enabled: root.rules.length > 1 && root.modal == "" && !root.busy; move-up => { if index > 0 { root.action("rule-up", rule.id); } } move-down => { if index + 1 < root.rules.length { root.action("rule-down", rule.id); } } }
                                Text { text: index + 1; color: Colors.muted; font-size: 10px; vertical-alignment: center; }
                                Rectangle { width: 38px; height: 38px; border-width: 1px; border-color: Colors.strong-line; border-radius: 10px; background: Colors.raised; Glyph { name: "code"; x: 10px; y: 10px; } }
                                VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 7px; alignment: center; Text { text: rule.name; color: Colors.label; font-size: 13px; font-weight: Typography.title-weight; overflow: elide; } Text { text: rule.process; color: Colors.muted; font-size: 11px; overflow: elide; } }
                                Text { text: rule.profile; color: Colors.secondary; font-size: 11px; vertical-alignment: center; overflow: elide; max-width: 140px; }
                                Toggle { checked: rule.enabled; enabled: root.modal == "" && !root.busy; label: "Enable application"; toggled => { root.action("toggle-rule", rule.id); } }
                                UiButton { text: "Edit"; compact: true; enabled: root.modal == "" && !root.busy; clicked => { root.action("edit-rule", rule.id); } }
                                IconButton { icon: "trash"; label: "Delete application"; enabled: root.modal == "" && !root.busy; clicked => { root.action("delete-rule", rule.id); } }
                            }
                            drop := DropArea {
                                enabled: root.modal == "" && !root.busy && root.rules.length > 1;
                                can-drop(event) => {
                                    rule-row.drop-after = event.position.y >= rule-row.height / 2;
                                    if root.rule-drag-id(event.data) != "" && root.rule-drag-id(event.data) != rule.id { return DragAction.move; }
                                    return DragAction.none;
                                }
                                dropped(event) => {
                                    root.rule-reordered(root.rule-drag-id(event.data), rule.id, event.position.y >= rule-row.height / 2);
                                    return DragAction.move;
                                }
                            }
                            if drop.has-drag: Rectangle { x: 12px; y: rule-row.drop-after ? parent.height - 2px : 0px; width: parent.width - 24px; height: 2px; border-radius: 1px; background: Colors.positive; }
                        }
                    }
                }
                Rectangle {
                    min-height: apps-layout.preferred-height; background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
                    apps-layout := VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout { cross-axis-alignment: center; padding: 24px; spacing: 16px; SectionTitle { title: "Open applications"; description: "Add a process to match a presence. Window titles stay on this device until included in a live presence."; } UiButton { text: root.scanning ? "Scanning…" : "Scan applications"; icon: "refresh"; enabled: root.modal == "" && !root.scanning; clicked => { root.action("scan", ""); } } }
                        if root.apps.length == 0: EmptyState { icon: "monitor"; title: root.scanning ? "Scanning open applications…" : "No open applications listed"; description: "Scan applications to find the windows currently open on your computer."; }
                        for app in root.apps: Rectangle {
                            height: 76px; Divider { y: 0px; width: parent.width; background: Colors.subtle-line; }
                            HorizontalLayout { cross-axis-alignment: center; padding-left: 24px; padding-right: 20px; spacing: 14px; Glyph { name: "monitor"; width: 18px; height: 18px; } VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 7px; alignment: center; Text { text: app.process; color: Colors.label; font-size: 12px; font-weight: Typography.title-weight; overflow: elide; } Text { text: app.title; color: Colors.muted; font-size: 11px; overflow: elide; } } UiButton { text: "Add application"; icon: "plus"; compact: true; enabled: root.modal == "" && !root.busy; clicked => { root.action("add-detected", app.id); } } }
                        }
                    }
                }
            }

            if root.page == 2: VerticalLayout {
                spacing: 25px;
                Rectangle {
                    min-height: 96px; background: @linear-gradient(115deg, Colors.raised, Colors.surface); border-width: 1px; border-color: Colors.strong-line; border-radius: 12px;
                    HorizontalLayout { cross-axis-alignment: center; padding: 24px; spacing: 18px; Rectangle { width: 46px; height: 46px; border-width: 1px; border-color: Colors.strong-line; border-radius: 12px; background: Colors.subtle-line; Glyph { name: "clock"; x: 11px; y: 11px; width: 24px; height: 24px; } } SectionTitle { title: "Record application time"; description: "Save cumulative time and previous sessions while an automatic presence is live. Turning this off keeps your history."; } Text { text: root.record-time ? "Enabled" : "Off"; color: Colors.muted; font-size: 12px; vertical-alignment: center; } Toggle { checked: root.record-time; enabled: root.modal == "" && !root.busy; label: "Record application time"; toggled => { root.action("toggle-recording", ""); } } }
                }
                HistorySection { title: "Application time"; description: "Archive keeps the total here and updates its Archive entry after each completed recording. Delete removes the total; session history is kept. Pause recording to delete the active total."; empty-text: "No recorded time yet. Enable recording and start an automatic application presence."; entries: root.totals; busy: root.busy || root.modal != ""; action(name,arg) => { root.action(name,arg); } }
                HistorySection { title: "This session"; empty-text: "A fresh start. Your connection and presence updates will appear here when you go live."; entries: root.events; busy: root.busy || root.modal != ""; action(name,arg) => { root.action(name,arg); } }
                HistorySection { title: "Previous sessions"; description: "Your most recent 500 completed sessions. Deleting or archiving an entry keeps its cumulative recorded time."; empty-text: "Completed sessions will appear here and remain available after restarting the app."; entries: root.sessions; busy: root.busy || root.modal != ""; action(name,arg) => { root.action(name,arg); } }
                HistorySection { title: "Archive"; description: "Saved entries stay here across restarts until you delete them."; empty-text: "Use an entry's archive button to save it here permanently."; entries: root.archived; archived: true; busy: root.busy || root.modal != ""; action(name,arg) => { root.action(name,arg); } }
            }
            if root.page == 3: HistorySection { title: "Saved activity"; description: "Archived events, application totals, and sessions remain here across restarts."; empty-text: "Your archive is empty. Save an entry from the activity log to keep it here."; entries: root.archived; archived: true; busy: root.busy || root.modal != ""; action(name,arg) => { root.action(name,arg); } }
            if root.page == 4: VerticalLayout {
                spacing: 25px;
                Rectangle {
                    min-height: appearance-content.preferred-height; background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
                    appearance-content := VerticalLayout {
                        padding: 24px; spacing: 22px;
                        SectionTitle { title: "Appearance"; description: "Choose a color mode. Changes save automatically."; }
                        Rectangle {
                            height: 42px; max-width: 420px;
                            accessible-role: radio-group; accessible-label: "Color mode";
                            HorizontalLayout {
                                spacing: 8px;
                                for mode[index] in ["dark", "light", "system"]: ModeOption {
                                    text: mode == "dark" ? "Dark" : mode == "light" ? "Light" : "System";
                                    checked: root.appearance == mode;
                                    enabled: root.modal == "" && !root.busy;
                                    clicked => { root.action("set-appearance", mode); }
                                    step(delta) => {
                                        let current = root.appearance == "dark" ? 0 : root.appearance == "light" ? 1 : 2;
                                        let next = Math.mod(current + delta + 3, 3);
                                        root.action("set-appearance", next == 0 ? "dark" : next == 1 ? "light" : "system");
                                    }
                                }
                            }
                        }
                        Text { text: root.appearance == "system" ? "Follows your system appearance and updates automatically." : root.appearance == "light" ? "Light surfaces with dark text for a brighter workspace." : "OLED black backgrounds. The default Presence Control theme."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    min-height: settings-content.preferred-height; background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
                    settings-content := VerticalLayout {
                        padding: 24px; spacing: 22px;
                        SectionTitle { title: "Discord connection"; description: "Set one application ID for all your presences. Individual presences can optionally override it in Connection."; }
                        Field { label: "Global Discord application ID"; hint: "Use the public Application ID from the Discord Developer Portal."; value <=> root.global-id-draft; placeholder: "e.g. 123456789012345678"; enabled: root.modal == "" && !root.busy; edited(value) => { root.action("edit-global-id", value); } }
                        HorizontalLayout { cross-axis-alignment: center; spacing: 12px; alignment: start; UiButton { text: "Save application ID"; icon: "check"; primary: true; enabled: root.modal == "" && !root.busy && root.global-id-dirty; clicked => { root.action("save-global-id", ""); } } UiButton { enabled: root.modal == ""; text: "Open Developer Portal"; icon: "external"; clicked => { root.action("developer-portal", ""); } } }
                        if root.global-id-dirty: Text { text: "Unsaved application ID. Save it here, or go live with a presence that uses the global ID."; color: Colors.warning; font-size: 11px; wrap: word-wrap; }
                        Note { text: "One ID is enough for custom names, text, timers, and buttons. Separate IDs are useful when presences need different Discord applications or uploaded artwork libraries."; }
                    }
                }
                Rectangle {
                    min-height: data-content.preferred-height; background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
                    data-content := VerticalLayout {
                        padding: 24px; spacing: 22px;
                        SectionTitle { title: "Your data"; description: "Presences and applications are stored locally. Take a backup or move them to another device."; }
                        HorizontalLayout { cross-axis-alignment: center; spacing: 12px; alignment: start; UiButton { text: "Export workspace"; icon: "down"; enabled: root.modal == "" && !root.busy; clicked => { root.action("export", ""); } } UiButton { text: "Import workspace"; icon: "up"; enabled: root.modal == "" && !root.busy; clicked => { root.action("import", ""); } } }
                        Note { text: "Import replaces the current workspace. Export first if you want to keep your current profiles. Application time and archived entries are stored separately."; }
                        Text { text: "Data folder\n" + root.data-path; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    min-height: 194px; background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 12px;
                    VerticalLayout { padding: 24px; spacing: 18px; Text { text: "About Presence Control"; color: Colors.heading; font-size: 15px; font-weight: Typography.title-weight; } HorizontalLayout { cross-axis-alignment: center; Text { text: "Version"; color: Colors.muted; font-size: 12px; } Text { text: root.app-version + " · Rust Complete Rewrite"; color: Colors.label; font-size: 12px; horizontal-alignment: right; } } HorizontalLayout { cross-axis-alignment: center; Text { text: "Runtime"; color: Colors.muted; font-size: 12px; } Text { text: "Native Rust · Slint"; color: Colors.label; font-size: 12px; horizontal-alignment: right; } } HorizontalLayout { cross-axis-alignment: center; Text { text: "Connection"; color: Colors.muted; font-size: 12px; } Text { text: "Local Discord IPC"; color: Colors.label; font-size: 12px; horizontal-alignment: right; } } }
                }
            }
            Rectangle { min-height: 16px; background: transparent; }
            Text { text: "Presence Control   v" + root.app-version; color: Colors.muted; font-size: 10px; horizontal-alignment: right; }
        }
    }

    if root.message != "": Rectangle {
        x: root.sidebar-width + (root.width - root.sidebar-width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: min(root.width - root.sidebar-width - 50px, 660px);
        height: toast-layout.preferred-height;
        background: Colors.popup; border-width: 1px; border-color: Colors.strong-line; border-radius: 10px;
        toast-layout := HorizontalLayout { cross-axis-alignment: center; padding: 15px; spacing: 13px; Glyph { name: "help"; colorize: Colors.positive; } Text { text: root.message; color: Colors.label; font-size: 12px; wrap: word-wrap; } IconButton { enabled: root.modal == ""; icon: "close"; label: "Dismiss notification"; clicked => { root.action("dismiss-message", ""); } } }
    }
    Rectangle {
        visible: root.modal != "";
        width: root.width; height: root.height; background: Colors.overlay;
        TouchArea { }
        dialog-focus := FocusScope {
        enabled: root.modal != "";
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.action("modal-cancel", ""); return accept; } return reject; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(520px, root.width - 60px); height: modal-content.preferred-height;
            border-width: 1px; border-color: Colors.strong-line; border-radius: 14px; background: Colors.raised;
            modal-content := VerticalLayout {
                padding: 28px; spacing: 22px;
                HorizontalLayout { cross-axis-alignment: center;
                    Text { text: root.modal == "rule" ? "Application rule" : root.modal == "delete-profile" ? "Delete this presence?" : "You have unsaved changes"; color: Colors.heading; font-size: 22px; font-weight: Typography.title-weight; vertical-alignment: center; }
                    IconButton { icon: "close"; label: "Close dialog"; clicked => { root.action("modal-cancel", ""); } }
                }
                if root.modal == "rule": VerticalLayout {
                    spacing: 20px;
                    Field { label: "Application name"; value <=> root.rule-form.name; placeholder: "e.g. Coding sessions"; edited(value) => { root.rule-edited("name", value); } }
                    Field { label: "Process name"; value <=> root.rule-form.process; placeholder: "e.g. Code.exe"; edited(value) => { root.rule-edited("process", value); } }
                    Field { label: "Window title contains (optional)"; value <=> root.rule-form.title-contains; placeholder: "Match part of the window title"; edited(value) => { root.rule-edited("titleContains", value); } }
                    VerticalLayout { spacing: 9px; Text { text: "Presence"; color: Colors.label; font-size: 12px; } Choice { label: "Presence"; options: root.profile-names; current-index <=> root.rule-form.profile-index; selected(index) => { root.rule-edited("profileIndex", index); } } }
                    HorizontalLayout { cross-axis-alignment: center; Text { text: "Enabled"; color: Colors.label; vertical-alignment: center; } Toggle { checked: root.rule-form.enabled; label: "Enable rule"; toggled => { root.rule-edited("enabled", root.rule-form.enabled ? "false" : "true"); } } }
                    HorizontalLayout { cross-axis-alignment: center; alignment: end; spacing: 10px; UiButton { text: "Cancel"; clicked => { root.action("modal-cancel", ""); } } UiButton { text: "Save application"; primary: true; enabled: !root.busy; clicked => { root.action("save-rule", ""); } } }
                }
                if root.modal == "delete-profile": VerticalLayout {
                    spacing: 24px;
                    Text { text: "This removes “" + root.form.name + "” and its application rules from your workspace."; color: Colors.secondary; font-size: 13px; wrap: word-wrap; }
                    HorizontalLayout { cross-axis-alignment: center; alignment: end; spacing: 10px; UiButton { text: "Keep presence"; clicked => { root.action("modal-cancel", ""); } } UiButton { text: "Delete presence"; danger: true; enabled: !root.busy; clicked => { root.action("confirm-delete-profile", ""); } } }
                }
                if root.modal != "rule" && root.modal != "delete-profile": VerticalLayout {
                    spacing: 24px;
                    Text { text: "Save your edits before continuing, or discard them to return to the saved presence."; color: Colors.secondary; font-size: 13px; wrap: word-wrap; }
                    HorizontalLayout { cross-axis-alignment: center; alignment: end; spacing: 10px; UiButton { text: "Cancel"; clicked => { root.action("modal-cancel", ""); } } UiButton { text: "Discard"; clicked => { root.action("discard-changes", ""); } } UiButton { text: "Save changes"; primary: true; enabled: !root.busy; clicked => { root.action("save-and-continue", ""); } } }
                }
            }
        }
        }
    }
}
