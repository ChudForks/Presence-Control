import { ScrollView, Palette } from "std-widgets.slint";

export global Colors {
    // Palette resolves Unknown against the live OS theme. Read its effective
    // background because color-scheme itself stays Unknown in System mode.
    out property <bool> dark: Palette.background.to-oklch().lightness < 0.5;
    out property <color> background: dark ? #000000 : #f5f6f8;
    out property <color> surface: dark ? #0a0a0a : #ffffff;
    out property <color> raised: dark ? #111111 : #f7f8fa;
    out property <color> input: dark ? #050505 : #fcfcfd;
    out property <color> hover: dark ? #191919 : #e9ecf1;
    out property <color> subtle-hover: dark ? #0c0c0c : #eef0f4;
    out property <color> selected: dark ? #141414 : #e9edf4;
    out property <color> badge: dark ? #222222 : #e3e6ed;
    out property <color> popup: dark ? #151515 : #ffffff;
    out property <color> popup-selected: dark ? #2a2a2a : #e9edf4;
    out property <color> line: dark ? #262626 : #d9dde5;
    out property <color> subtle-line: dark ? #1b1b1b : #e5e8ee;
    out property <color> strong-line: dark ? #333333 : #c5cbd5;
    out property <color> focus: dark ? #8e8e8e : #707d91;
    out property <color> heading: dark ? #eeeeee : #171c25;
    out property <color> text: dark ? #f2f2f2 : #202632;
    out property <color> label: dark ? #d5d5d5 : #343d4b;
    out property <color> secondary: dark ? #a3a3a3 : #535f70;
    out property <color> muted: dark ? #818181 : #657184;
    out property <color> placeholder: dark ? #777777 : #717c8e;
    out property <color> primary: dark ? #ededed : #252e3d;
    out property <color> primary-hover: dark ? #ffffff : #111823;
    out property <color> on-primary: dark ? #151515 : #ffffff;
    out property <color> toggle: dark ? #dedede : #343f51;
    out property <color> toggle-off: dark ? #252525 : #dde2ea;
    out property <color> toggle-knob: dark ? #222222 : #ffffff;
    out property <color> selection: dark ? #555555 : #d7e1f5;
    out property <color> selection-text: dark ? #ffffff : #172b4d;
    out property <color> positive: dark ? #8bd5ad : #23734d;
    out property <color> positive-surface: dark ? #0a160f : #eef8f2;
    out property <color> positive-line: dark ? #284233 : #badfca;
    out property <color> warning: dark ? #dcba7f : #895b10;
    out property <color> danger: #a8394d;
    out property <color> on-danger: #ffffff;
    out property <color> overlay: dark ? #000000b8 : #11182766;
    out property <color> artwork-line: dark ? #ffffff14 : #00000014;
}

// Match the preceding studio's typography. Sharpness and contrast are handled
// once in the renderer, for Text and TextInput on every page.
export global Typography {
    out property <int> body-weight: 400;
    out property <int> label-weight: 500;
    out property <int> title-weight: 600;
    out property <int> heading-weight: 550;
    out property <int> brand-weight: 650;
    out property <int> selected-nav-weight: 500;
    out property <int> caption-weight: 600;
}

export component Glyph inherits Image {
    in property <string> name;
    width: 18px;
    height: 18px;
    colorize: Colors.secondary;
    image-fit: contain;
    source: name == "layers" ? @image-url("icons/layers.svg") :
        name == "wand" ? @image-url("icons/wand.svg") :
        name == "activity" ? @image-url("icons/activity.svg") :
        name == "settings" ? @image-url("icons/settings.svg") :
        name == "plus" ? @image-url("icons/plus.svg") :
        name == "copy" ? @image-url("icons/copy.svg") :
        name == "trash" ? @image-url("icons/trash.svg") :
        name == "check" ? @image-url("icons/check.svg") :
        name == "image" ? @image-url("icons/image.svg") :
        name == "link" ? @image-url("icons/link.svg") :
        name == "plug" ? @image-url("icons/plug.svg") :
        name == "radio" ? @image-url("icons/radio.svg") :
        name == "monitor" ? @image-url("icons/monitor.svg") :
        name == "clock" ? @image-url("icons/clock.svg") :
        name == "archive" ? @image-url("icons/archive.svg") :
        name == "refresh" ? @image-url("icons/refresh.svg") :
        name == "help" ? @image-url("icons/help.svg") :
        name == "external" ? @image-url("icons/external.svg") :
        name == "arrow" ? @image-url("icons/arrow.svg") :
        name == "search" ? @image-url("icons/search.svg") :
        name == "audio" ? @image-url("icons/audio.svg") :
        name == "close" ? @image-url("icons/close.svg") :
        name == "up" ? @image-url("icons/up.svg") :
        name == "down" ? @image-url("icons/down.svg") :
        name == "grip" ? @image-url("icons/grip.svg") :
        name == "stop" ? @image-url("icons/stop.svg") :
        @image-url("icons/code.svg");
}

export component UiButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked();
    width: content.preferred-width + (compact ? 20px : 28px);
    height: compact ? 32px : 40px;
    horizontal-stretch: 0;
    border-width: 1px;
    border-radius: 8px;
    border-color: focus.has-focus ? Colors.focus : primary ? Colors.primary : danger ? Colors.danger : touch.has-hover ? Colors.focus : Colors.strong-line;
    background: primary ? (touch.has-hover ? Colors.primary-hover : Colors.primary) : danger ? Colors.danger : touch.has-hover ? Colors.hover : Colors.raised;
    opacity: enabled ? 1 : 0.38;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    content := HorizontalLayout { cross-axis-alignment: center;
        alignment: center;
        spacing: 8px;
        padding-left: 0px;
        padding-right: 0px;
        if icon != "": Glyph { name: root.icon; colorize: root.primary ? Colors.on-primary : root.danger ? Colors.on-danger : Colors.secondary; width: 15px; height: 15px; }
        Text { text: root.text; color: root.primary ? Colors.on-primary : root.danger ? Colors.on-danger : Colors.label; font-size: root.compact ? 11px : 12px; font-weight: Typography.title-weight; vertical-alignment: center; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 7px;
    background: touch.has-hover ? Colors.hover : transparent;
    border-width: touch.has-hover ? 1px : 0px;
    border-color: Colors.strong-line;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    Glyph { name: root.icon; x: 8px; y: 8px; width: 16px; height: 16px; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    forward-focus: focus;
}

export component ModeOption inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    callback step(int);
    height: 42px;
    min-width: 88px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: focus.has-focus ? Colors.focus : checked ? Colors.primary : Colors.line;
    background: checked ? Colors.primary : touch.has-hover ? Colors.hover : Colors.input;
    opacity: enabled ? 1 : 0.5;
    accessible-role: radio-button;
    accessible-label: text;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Text { text: root.text; color: root.checked ? Colors.on-primary : Colors.label; font-size: 13px; font-weight: Typography.label-weight; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.clicked(); return accept; }
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.step(-1); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.step(1); return accept; }
            return reject;
        }
    }
    forward-focus: focus;
}

export component Input inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label: root.placeholder;
    in property <bool> enabled: true;
    callback edited(string);
    height: 42px;
    border-width: 1px;
    border-color: edit.has-focus ? Colors.focus : Colors.line;
    background: Colors.input;
    border-radius: 8px;
    clip: true;
    forward-focus: edit;
    accessible-role: none;
    edit := TextInput {
        x: 13px;
        y: 1px;
        width: max(parent.width - 26px, self.preferred-width);
        height: parent.height - 2px;
        text <=> root.text;
        enabled: root.enabled;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        accessible-enabled: root.enabled;
        color: Colors.text;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        selection-background-color: Colors.selection;
        selection-foreground-color: Colors.selection-text;
        edited => { root.edited(self.text); }
        cursor-position-changed(pos) => {
            if pos.x + self.x < 13px { self.x = 13px - pos.x; }
            if pos.x + self.x > parent.width - 13px { self.x = parent.width - 13px - pos.x; }
        }
    }
    if text == "": Text { x: 13px; width: parent.width - 26px; height: parent.height; text: root.placeholder; color: Colors.placeholder; font-size: 13px; vertical-alignment: center; }
}

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> enabled: true;
    callback edited(string);
    spacing: 9px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    Text { text: root.label; color: Colors.label; font-size: 12px; font-weight: Typography.label-weight; }
    Input { label: root.label; text <=> root.value; placeholder: root.placeholder; enabled: root.enabled; edited(value) => { root.edited(value); } }
    if hint != "": Text { text: root.hint; color: Colors.muted; font-size: 11px; wrap: word-wrap; }
}

export component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 6px;
    horizontal-stretch: 1;
    min-width: 0px;
    Text { text: root.title; color: Colors.heading; font-size: 13px; font-weight: Typography.title-weight; }
    if description != "": Text { text: root.description; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Colors.toggle : Colors.toggle-off;
    border-width: 1px;
    border-color: checked ? Colors.toggle : Colors.strong-line;
    opacity: enabled ? 1 : 0.4;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-checked: checked;
    accessible-action-default => { if enabled { root.toggled(); } }
    Rectangle { x: root.checked ? 17px : 3px; y: 4px; width: 12px; height: 12px; border-radius: 6px; background: root.checked ? Colors.toggle-knob : Colors.muted; animate x { duration: 120ms; } }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.toggled(); } }
    focus := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Space { root.toggled(); return accept; } return reject; } }
    forward-focus: focus;
}

export component Artwork inherits Rectangle {
    in property <string> theme: "violet";
    in property <image> artwork;
    in property <bool> has-artwork: false;
    border-radius: root.width <= 24px ? root.width / 2 : root.width <= 48px ? 10px : root.width <= 70px ? 9px : 13px;
    background: transparent;
    // Downloaded images already contain the correct rounded alpha mask.
    // clip + border-radius is unsupported by Slint's software renderer.
    if !has-artwork && root.width > 24px: Image {
        width: parent.width; height: parent.height;
        source: root.theme == "mint" ? (root.width <= 48px ? @image-url("artwork/mint-small.svg") : root.width <= 70px ? @image-url("artwork/mint-preview.svg") : @image-url("artwork/mint-large.svg")) :
            root.theme == "peach" ? (root.width <= 48px ? @image-url("artwork/peach-small.svg") : root.width <= 70px ? @image-url("artwork/peach-preview.svg") : @image-url("artwork/peach-large.svg")) :
            root.theme == "blue" ? (root.width <= 48px ? @image-url("artwork/blue-small.svg") : root.width <= 70px ? @image-url("artwork/blue-preview.svg") : @image-url("artwork/blue-large.svg")) :
            (root.width <= 48px ? @image-url("artwork/violet-small.svg") : root.width <= 70px ? @image-url("artwork/violet-preview.svg") : @image-url("artwork/violet-large.svg"));
    }
    if !has-artwork && root.width <= 24px: Rectangle {
        border-radius: parent.width / 2; background: #425e53;
        Glyph { name: "wand"; x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; colorize: #def3e6; }
    }
    if has-artwork: Image { width: parent.width; height: parent.height; source: root.artwork; image-fit: cover; }
    Rectangle { width: parent.width; height: parent.height; border-radius: root.border-radius; border-width: root.width <= 24px ? 0px : 1px; border-color: Colors.artwork-line; background: transparent; }
}

export component Note inherits Rectangle {
    in property <string> text;
    in property <string> icon: "help";
    min-height: note-content.preferred-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: Colors.line;
    background: Colors.raised;
    note-content := HorizontalLayout { cross-axis-alignment: center;
        padding: 13px;
        spacing: 10px;
        Glyph { name: root.icon; width: 16px; height: 16px; }
        Text { text: root.text; color: Colors.secondary; font-size: 11px; wrap: word-wrap; }
    }
}

export component Divider inherits Rectangle { height: 1px; background: Colors.badge; }

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> icon: "code";
    min-height: content.preferred-height;
    background: transparent;
    Divider { y: 0px; width: parent.width; background: Colors.subtle-line; }
    content := HorizontalLayout {
        cross-axis-alignment: center; padding: 24px; spacing: 14px;
        Rectangle {
            width: 38px; height: 38px; border-radius: 10px; border-width: 1px; border-color: Colors.strong-line; background: Colors.selected;
            Glyph { name: root.icon; x: 10px; y: 10px; }
        }
        VerticalLayout {
            min-width: 0px; horizontal-stretch: 1; spacing: 7px;
            Text { text: root.title; color: Colors.label; font-size: 13px; font-weight: Typography.title-weight; wrap: word-wrap; }
            Text { text: root.description; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
        }
    }
}

export component PriorityHandle inherits Rectangle {
    in property <data-transfer> data;
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> dragging: drag.dragging;
    callback move-up();
    callback move-down();
    width: 28px; height: 40px;
    border-radius: 6px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Colors.placeholder;
    background: focus.has-focus || touch.has-hover ? Colors.hover : transparent;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: label + ". Drag to reorder, or use the Up and Down arrow keys.";
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { focus.focus(); } }
    Glyph { name: "grip"; x: 5px; y: 11px; width: 18px; height: 18px; colorize: root.enabled ? Colors.secondary : Colors.focus; }
    drag := DragArea {
        enabled: root.enabled; data: root.data; allow-move: true;
        drag-image: @image-url("icons/grip.svg"); drag-image-offset-x: 12; drag-image-offset-y: 12;
        touch := TouchArea { enabled: root.enabled; mouse-cursor: drag.dragging ? grabbing : grab; clicked => { focus.focus(); } }
    }
    focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.move-up(); return accept; }
            if event.text == Key.DownArrow { root.move-down(); return accept; }
            return reject;
        }
    }
    forward-focus: focus;
}

export component Choice inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    private property <bool> popup-open: false;
    callback selected(int);
    height: 42px;
    horizontal-stretch: 1;
    background: Colors.input;
    border-width: 1px;
    border-color: choice-touch.has-hover ? Colors.focus : Colors.line;
    border-radius: 8px;
    accessible-role: combobox;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-value: root.current-index >= 0 && root.current-index < root.options.length ? root.options[root.current-index] : "";
    accessible-expandable: true;
    accessible-expanded: root.popup-open;
    accessible-action-expand => { if root.enabled { menu.show(); } }
    Text { x: 13px; width: parent.width - 44px; height: parent.height; text: root.current-index >= 0 && root.current-index < root.options.length ? root.options[root.current-index] : "Choose a presence"; color: Colors.heading; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Glyph { name: "down"; x: parent.width - 29px; y: 14px; width: 14px; height: 14px; }
    choice-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); menu.show(); } }
    menu := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: root.width;
        height: min(300px, root.options.length * 36px + 12px);
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            focus-changed-event => { root.popup-open = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.Escape { menu.close(); focus.focus(); return accept; }
                if event.text == Key.Return || event.text == Key.Space { root.selected(root.current-index); menu.close(); focus.focus(); return accept; }
                if event.text == Key.DownArrow && root.options.length > 0 { root.current-index = min(root.options.length - 1, root.current-index + 1); root.selected(root.current-index); return accept; }
                if event.text == Key.UpArrow && root.options.length > 0 { root.current-index = max(0, root.current-index - 1); root.selected(root.current-index); return accept; }
                return reject;
            }
        Rectangle {
            background: Colors.popup; border-radius: 8px; border-width: 1px; border-color: Colors.strong-line;
            option-scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: root.options.length * 36px + 12px;
                content-y: -max(0px, min(root.current-index * 36px - 126px, self.content-height - self.visible-height));
            VerticalLayout {
                width: option-scroll.visible-width;
                height: root.options.length * 36px + 12px;
                padding: 6px;
                for option[index] in root.options: Rectangle {
                    height: 36px; border-radius: 5px; background: item-touch.has-hover || root.current-index == index ? Colors.popup-selected : transparent;
                    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: option; color: Colors.heading; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    item-touch := TouchArea { mouse-cursor: pointer; clicked => { root.current-index = index; root.selected(index); menu.close(); } }
                }
            }
            }
        }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { menu.show(); return accept; }
            if event.text == Key.DownArrow && root.options.length > 0 { root.current-index = min(root.options.length - 1, root.current-index + 1); root.selected(root.current-index); return accept; }
            if event.text == Key.UpArrow && root.options.length > 0 { root.current-index = max(0, root.current-index - 1); root.selected(root.current-index); return accept; }
            return reject;
        }
    }
    forward-focus: focus;
}
